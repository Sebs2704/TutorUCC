# =============================================
#   VARIABLES DE ENTORNO - TutorUCC
#   Copia este archivo a .env y completa los valores
# =============================================

PORT=3000

# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/TutorUCC?retryWrites=true&w=majority

# Clave secreta para JWT (genera una con: node -e "require('crypto').randomBytes(48).toString('hex')")
JWT_SECRET=

# Tiempo de expiración del token
JWT_EXPIRES_IN=1d

# Origenes permitidos por CORS (separados por coma, sin espacios)
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Correo para envío de confirmaciones (Gmail)
# Activa "Contraseñas de aplicación" en tu cuenta Google
EMAIL_USER=
EMAIL_PASS=
